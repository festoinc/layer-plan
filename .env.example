# Copy this file to .env and set a real super-admin password.
# .env is ignored by git. The password is stored in plaintext on disk.
# The password bootstraps the super admin on a fresh database. After that,
# change it from the account page; editing this value does not overwrite it.
LAYERS_SUPER_ADMIN_EMAIL=admin@example.com
LAYERS_SUPER_ADMIN_PASSWORD=replace-with-at-least-12-characters
LAYERS_SUPER_ADMIN_NAME=Super Admin

# Optional auth settings
# LAYERS_SESSION_TTL_DAYS=30
# LAYERS_SECURE_COOKIES=0
# LAYERS_UI_ORIGIN=http://127.0.0.1:5173
# LAYERS_LOGIN_RATE_LIMIT=5
# LAYERS_LOGIN_RATE_WINDOW_MINUTES=15
# MCP accepts localhost by default. Set the actual public hostname for remote clients.
# LAYERS_MCP_ALLOWED_HOSTS=layers.example.com,localhost,127.0.0.1

# Docker Compose on the remote server.
# The image already defaults HOST=0.0.0.0, LAYERS_ALLOW_REMOTE=1,
# LAYERS_DB_PATH=/app/data/layers.sqlite and LAYERS_SEED_SAMPLES=0.
# LAYERS_SUPER_ADMIN_EMAIL and LAYERS_SUPER_ADMIN_PASSWORD above are required.
# LAYERS_HTTP_PORT=80

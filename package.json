{
  "name": "layers-specification-mockup",
  "private": true,
  "version": "1.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c cyan,magenta \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:e2e": "cross-env LAYERS_DB_PATH=test-results/e2e.sqlite LAYERS_SEED_SAMPLES=1 LAYERS_TEST_MODE=1 npm run db:reset && cross-env LAYERS_DB_PATH=test-results/e2e.sqlite LAYERS_SEED_SAMPLES=1 LAYERS_TEST_MODE=1 concurrently -k -n api,ui \"npm:dev:api\" \"npm:dev:ui\"",
    "db:migrate": "tsx server/db/migrate-cli.ts",
    "db:reset": "tsx server/db/reset.ts",
    "api:spec": "tsx server/api/export-spec.ts",
    "api:types": "openapi-typescript server/api/openapi.yaml -o server/api/generated.d.ts && prettier --write server/api/generated.d.ts",
    "api:lint": "redocly lint server/api/openapi.yaml",
    "build": "npm run build:ui && npm run build:api",
    "build:ui": "vite build",
    "build:api": "tsup server/index.ts --format esm --platform node --out-dir dist-server --clean --external better-sqlite3 --external @node-rs/argon2",
    "start": "node dist-server/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:api": "vitest run tests/api",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:api && npm run test:contract && playwright test",
    "test:prod": "npm run build && cross-env LAYERS_DB_PATH=test-results/prod.sqlite LAYERS_SEED_SAMPLES=1 LAYERS_TEST_MODE=1 npm run db:reset && cross-env LAYERS_DB_PATH=test-results/prod.sqlite LAYERS_SEED_SAMPLES=1 LAYERS_TEST_MODE=1 E2E_TARGET=production playwright test tests/smoke.spec.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-rs/argon2": "^2.2.2",
    "@scalar/fastify-api-reference": "^1.78.0",
    "better-sqlite3": "^13.1.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@redocly/cli": "^2.77.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
